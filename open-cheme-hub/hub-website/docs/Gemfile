# Gemfile for local preview of the Open ChemE Hub website.
#
#     cd docs
#     bundle install
#     bundle exec jekyll serve --livereload
#     open http://localhost:4000
#
# GitHub Pages builds this site itself and ignores this file — it uses the
# `github-pages` gem's own pinned dependency set. The point of pinning to that
# same gem here is that a local build and the deployed build agree; installing
# a newer standalone Jekyll locally is the usual reason a site "works on my
# machine" and then renders differently in production.

source "https://rubygems.org"

# This single gem pins Jekyll and every plugin to exactly what GitHub Pages
# runs. Do not add a bare `gem "jekyll"` alongside it — they will fight.
gem "github-pages", "~> 232", group: :jekyll_plugins

group :jekyll_plugins do
  gem "jekyll-seo-tag"      # <meta> and JSON-LD from front matter
  gem "jekyll-sitemap"      # sitemap.xml, which search engines actually use
end

# Windows and JRuby need an explicit timezone database.
platforms :mingw, :x64_mingw, :mswin, :jruby do
  gem "tzinfo", ">= 1", "< 3"
  gem "tzinfo-data"
end

# Faster file watching on Windows.
gem "wdm", "~> 0.1", platforms: [:mingw, :x64_mingw, :mswin]

# Ruby 3.0 dropped webrick from the standard library; Jekyll's serve command
# still wants it.
gem "webrick", "~> 1.8"
